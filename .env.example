# URL base de la API. Vacío = mismo origen: Vite reenvía /api y /uploads al backend
# (http://localhost:3000) mediante su proxy, así funciona desde el celular por HTTPS.
# Pon una URL solo si la API vive en otro dominio con HTTPS, p. ej. https://api.escuela.com
VITE_API_URL=

# Destino del proxy de desarrollo (no se expone al navegador).
BACKEND_URL=http://localhost:3000
